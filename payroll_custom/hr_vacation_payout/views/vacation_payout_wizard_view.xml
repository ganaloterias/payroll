<odoo>
  <record id="view_hr_vacation_payout_wizard_form" model="ir.ui.view">
    <field name="model">hr.vacation.payout.wizard</field>
    <field name="arch" type="xml">
      <form string="Pago de Vacaciones">
        <group>
          <field name="employee_id"/>
          <field name="date"/>
          <field name="days_pending"/>
          <field name="amount"/>
        </group>
        <footer>
          <button name="action_pay_vacation" string="Pagar" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
