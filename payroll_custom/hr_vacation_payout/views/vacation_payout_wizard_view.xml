<odoo>
  <record id="view_hr_vacation_payout_wizard_form" model="ir.ui.view">
    <field name="model">hr.vacation.payout.wizard</field>
    <field name="arch" type="xml">
      <form string="Pago de Vacaciones">
        <group>
          <field name="employee_id"/>
          <field name="date"/>
          <field name="vacation_days"/>
          <field name="last_wage"/>
        </group>
        <footer>
          <button name="action_create_payout" string="Pagar" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
