<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista Mejorada -->
    <record id="view_hr_vacation_payout_list" model="ir.ui.view">
        <field name="name">hr.vacation.payout.list</field>
        <field name="model">hr.vacation.payout</field>
        <field name="arch" type="xml">
            <list string="Pagos de Vacaciones" 
                  default_order="date desc, name desc"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'validated'"
                  decoration-warning="state == 'draft'"
                  decoration-danger="state == 'rejected'">
                <field name="name" string="Referencia"/>
                <field name="employee_id" string="Empleado"/>
                <field name="date" string="Fecha"/>
                <field name="vacation_days" string="Días" widget="float_time"/>
                <field name="work_years" string="Años Servicio" widget="float_time"/>
                <field name="total_amount" string="Total" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" string="Estado" widget="badge" 
                       decoration-success="state == 'done'"
                       decoration-info="state == 'validated'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'rejected'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Vista de Formulario Mejorada -->
    <record id="view_hr_vacation_payout_form" model="ir.ui.view">
        <field name="name">hr.vacation.payout.form</field>
        <field name="model">hr.vacation.payout</field>
        <field name="arch" type="xml">
            <form string="Pago de Vacaciones">
                <header>
                    <button name="action_validate" type="object" string="Validar" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Marcar como Pagado" 
                            class="btn-success" invisible="state != 'validated'"/>
                    <button name="action_draft" type="object" string="Volver a Borrador" 
                            class="btn-secondary" invisible="state not in ['validated', 'rejected']"/>
                    <button name="action_reject" type="object" string="Rechazar" 
                            class="btn-danger" invisible="state not in ['draft', 'validated']"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,validated,done"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Referencia del pago"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Información del Empleado">
                            <field name="employee_id" string="Empleado" 
                                   options="{'no_create': True}" 
                                   readonly="state != 'draft'"/>
                            <field name="contract_id" string="Contrato" readonly="1"/>
                            <field name="work_years" string="Años de Servicio" readonly="1" widget="float_time"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group string="Información del Pago">
                            <field name="date" string="Fecha de Pago" readonly="state != 'draft'"/>
                            <field name="currency_id" string="Moneda"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="last_wage" string="Último Salario" 
                                   widget="monetary" readonly="state != 'draft'"/>
                            <field name="last_slip_id" string="Última Nómina" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Cálculo de Vacaciones">
                            <field name="vacation_days" string="Días de Vacaciones" 
                                   readonly="state != 'draft'"/>
                            <field name="vacation_bonus_days" string="Días Bono Vacacional" 
                                   readonly="1" widget="float_time"/>
                            <field name="vacation_amount" string="Monto Vacaciones" 
                                   readonly="1" widget="monetary"/>
                            <field name="vacation_bonus_amount" string="Monto Bono Vacacional" 
                                   readonly="1" widget="monetary"/>
                        </group>
                        <group string="Total">
                            <field name="total_amount" string="Total a Pagar" 
                                   readonly="1" widget="monetary" 
                                   class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Fechas de Vacaciones" name="vacation_dates">
                            <group>
                                <field name="create_leave" string="Crear Ausencia Automáticamente"/>
                                <field name="vacation_date_from" string="Fecha Inicio Vacaciones" 
                                       readonly="state != 'draft'"/>
                                <field name="vacation_date_to" string="Fecha Fin Vacaciones" 
                                       readonly="state != 'draft'"/>
                                <field name="leave_id" string="Ausencia Creada" readonly="1"/>
                                <field name="leave_state" string="Estado de la Ausencia" readonly="1"/>
                            </group>
                            <group invisible="not leave_id">
                                <button name="action_view_leave" type="object" 
                                        string="Ver Ausencia" class="btn-secondary"/>
                                <button name="action_view_leave_type" type="object" 
                                        string="Ver Tipo de Ausencia" class="btn-secondary"/>
                                <button name="action_cancel_leave" type="object" 
                                        string="Cancelar Ausencia" class="btn-danger"/>
                            </group>
                        </page>
                        
                        <page string="Líneas de Pago" name="payment_lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="description" string="Concepto"/>
                                    <field name="days" string="Días" widget="float_time"/>
                                    <field name="amount" string="Monto" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Detalles del Cálculo" name="calculation_details">
                            <field name="calculation_details" nolabel="1" readonly="1"/>
                        </page>
                        
                        <page string="Pagos Relacionados" name="related_payouts">
                            <field name="related_payouts" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="total_amount" widget="monetary"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Observaciones" name="notes">
                            <field name="notes" nolabel="1" placeholder="Observaciones adicionales..."/>
                        </page>
                        
                        <page string="Mensajes" name="messages" invisible="1">
                            <div class="oe_chatter">
                                <field name="message_follower_ids"/>
                                <field name="activity_ids"/>
                                <field name="message_ids"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda Mejorada -->
    <record id="view_hr_vacation_payout_search" model="ir.ui.view">
        <field name="name">hr.vacation.payout.search</field>
        <field name="model">hr.vacation.payout</field>
        <field name="arch" type="xml">
            <search string="Buscar Pagos de Vacaciones">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="total_amount"/>
                <separator/>
                <filter string="Borrador" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Validado" name="validated" domain="[('state','=','validated')]"/>
                <filter string="Pagado" name="done" domain="[('state','=','done')]"/>
                <filter string="Rechazado" name="rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter string="Este Mes" name="this_month" 
                        domain="[('date','>=',(context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Este Año" name="this_year" 
                        domain="[('date','>=',(context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Con Ausencia Creada" name="with_leave" 
                        domain="[('leave_id','!=',False)]"/>
                <filter string="Sin Ausencia" name="without_leave" 
                        domain="[('leave_id','=',False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Empleado" name="employee" 
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Estado" name="state" 
                            context="{'group_by': 'state'}"/>
                    <filter string="Mes" name="month" 
                            context="{'group_by': 'date:month'}"/>
                    <filter string="Año" name="year" 
                            context="{'group_by': 'date:year'}"/>
                    <filter string="Compañía" name="company" 
                            context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista de Calendario -->
    <record id="view_hr_vacation_payout_calendar" model="ir.ui.view">
        <field name="name">hr.vacation.payout.calendar</field>
        <field name="model">hr.vacation.payout</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Vacaciones" 
                      date_start="date" 
                      color="employee_id" 
                      event_limit="5"
                      form_view_id="view_hr_vacation_payout_form">
                <field name="employee_id" filters="1"/>
                <field name="state" filters="1"/>
                <field name="total_amount" widget="monetary"/>
                <field name="vacation_days" widget="float_time"/>
            </calendar>
        </field>
    </record>

    <!-- Vista Kanban Mejorada -->
    <record id="view_hr_vacation_payout_kanban" model="ir.ui.view">
        <field name="name">hr.vacation.payout.kanban</field>
        <field name="model">hr.vacation.payout</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="total_amount"/>
                <field name="currency_id"/>
                <field name="vacation_days"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details d-flex flex-column">
                                <div class="d-flex align-items-center mb-2">
                                    <strong class="flex-grow-1"><field name="name"/></strong>
                                    <span class="badge bg-warning" invisible="state != 'draft'">Borrador</span>
                                    <span class="badge bg-info" invisible="state != 'validated'">Validado</span>
                                    <span class="badge bg-success" invisible="state != 'done'">Pagado</span>
                                    <span class="badge bg-danger" invisible="state != 'rejected'">Rechazado</span>
                                </div>
                                <div class="d-flex flex-column mb-2">
                                    <span><b>Empleado:</b> <field name="employee_id"/></span>
                                    <span><b>Fecha:</b> <field name="date"/></span>
                                    <span><b>Días:</b> <field name="vacation_days"/> días</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span><b>Total:</b> <field name="total_amount" widget="monetary"/></span>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_right">
                                        <button name="action_validate" string="Validar" 
                                                type="object" class="btn btn-sm btn-primary" 
                                                invisible="state != 'draft'"/>
                                        <button name="action_done" string="Pagar" 
                                                type="object" class="btn btn-sm btn-success" 
                                                invisible="state != 'validated'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista de Gráfico -->
    <record id="view_hr_vacation_payout_graph" model="ir.ui.view">
        <field name="name">hr.vacation.payout.graph</field>
        <field name="model">hr.vacation.payout</field>
        <field name="arch" type="xml">
            <graph string="Pagos de Vacaciones" type="bar">
                <field name="date" interval="month"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Vista de Pivot -->
    <record id="view_hr_vacation_payout_pivot" model="ir.ui.view">
        <field name="name">hr.vacation.payout.pivot</field>
        <field name="model">hr.vacation.payout</field>
        <field name="arch" type="xml">
            <pivot string="Pagos de Vacaciones">
                <field name="date" interval="month" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Acción Principal Mejorada -->
    <record id="action_hr_vacation_payout" model="ir.actions.act_window">
        <field name="name">Pagos de Vacaciones</field>
        <field name="res_model">hr.vacation.payout</field>
        <field name="view_mode">list,form,calendar,kanban,graph,pivot</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No existen pagos de vacaciones registrados
            </p>
            <p>
                Cree un nuevo pago de vacaciones utilizando el botón "Nuevo" o el asistente.
            </p>
        </field>
    </record>

    <!-- Acción para Calendario de Ausencias -->
    <record id="action_hr_vacation_payout_absences" model="ir.actions.act_window">
        <field name="name">Calendario de Ausencias</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('holiday_status_id.name', 'ilike', 'vaca')]</field>
        <field name="context">{'search_default_vacation': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No existen ausencias por vacaciones registradas
            </p>
            <p>
                Las ausencias por vacaciones se crean automáticamente al validar los pagos.
            </p>
        </field>
    </record>

    <!-- Acción para el Wizard -->
    <record id="action_hr_vacation_payout_wizard" model="ir.actions.act_window">
        <field name="name">Crear Pago de Vacaciones</field>
        <field name="res_model">hr.vacation.payout.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_vacation_payout"/>
        <field name="binding_type">action</field>
    </record>
</odoo> 