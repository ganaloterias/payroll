<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_vacation_payout" model="ir.module.category">
        <field name="name">Pago de Vacaciones</field>
        <field name="description">Categoría para el módulo de pago de vacaciones</field>
        <field name="sequence">50</field>
    </record>

    <record id="rule_hr_vacation_payout_employee" model="ir.rule">
        <field name="name">Regla de Pagos de Vacaciones: Empleados</field>
        <field name="model_id" ref="model_hr_vacation_payout"/>
        <field name="domain_force">['|',('employee_id.user_id','=',user.id),('employee_id.department_id.manager_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="rule_hr_vacation_payout_manager" model="ir.rule">
        <field name="name">Regla de Pagos de Vacaciones: Gerentes</field>
        <field name="model_id" ref="model_hr_vacation_payout"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>
</odoo> 