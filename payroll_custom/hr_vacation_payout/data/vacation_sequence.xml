<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Secuencia para los pagos de vacaciones -->
    <record id="seq_hr_vacation_payout" model="ir.sequence">
        <field name="name">Secuencia de Pago de Vacaciones</field>
        <field name="code">hr.vacation.payout</field>
        <field name="prefix">VACACION/%(year)s/%(month)s/</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo> 