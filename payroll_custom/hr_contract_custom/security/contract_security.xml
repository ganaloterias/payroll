<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_contract_custom" model="ir.module.category">
        <field name="name">Contratos Multimoneda</field>
        <field name="description">Gestión de contratos multimoneda y líneas de salario</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_hr_contract_custom_user" model="res.groups">
        <field name="name">Usuario Contratos Multimoneda</field>
        <field name="category_id" ref="module_category_hr_contract_custom"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_hr_contract_custom_manager" model="res.groups">
        <field name="name">Administrador Contratos Multimoneda</field>
        <field name="category_id" ref="module_category_hr_contract_custom"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_contract_custom_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_hr_contract_custom_user" model="ir.rule">
        <field name="name">Acceso a contratos multimoneda</field>
        <field name="model_id" ref="hr_contract.model_hr_contract"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_contract_custom_user'))]"/>
    </record>
</odoo> 