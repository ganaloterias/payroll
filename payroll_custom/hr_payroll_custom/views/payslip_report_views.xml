<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_custom" inherit_id="payroll.report_payslip">
        <xpath expr="//table[1]" position="replace">
            <table class="table table-sm table-bordered">
                <tr>
                    <td><strong>Nombre</strong></td>
                    <td><span t-field="o.employee_id"/></td>
                    <td><strong>Cargo</strong></td>
                    <td><span t-field="o.employee_id.job_id"/></td>
                </tr>
                <tr>
                    <td><strong>Email</strong></td>
                    <td><span t-field="o.employee_id.work_email"/></td>
                    <td><strong>No. Identificación</strong></td>
                    <td><span t-field="o.employee_id.identification_id"/></td>
                </tr>
                <tr>
                    <td><strong>Referencia</strong></td>
                    <td><span t-field="o.number"/></td>
                    <td><strong>Cuenta Bancaria</strong></td>
                    <td>
                        <span t-field="o.employee_id.bank_account_id.bank_id.name"/> - 
                        <span t-field="o.employee_id.bank_account_id.acc_number"/>
                    </td>
                </tr>
                <tr>
                    <td><strong>Fecha Inicio</strong></td>
                    <td><span t-field="o.date_from"/></td>
                    <td><strong>Fecha Fin</strong></td>
                    <td><span t-field="o.date_to"/></td>
                </tr>
            </table>
        </xpath>

        <xpath expr="//table[2]" position="replace">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.line_ids.filtered(lambda line: line.appears_on_payslip)" t-as="line">
                        <td><span t-field="line.name"/></td>
                        <td>
                            <span t-esc="line.total" 
                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </xpath>

        <xpath expr="//h2" position="replace">
            <h2>Recibo de Nómina</h2>
        </xpath>
        <xpath expr="//p[hasclass('text-right')]" position="replace">
            <div class="mt-4">
                <p class="text-justify">
                    He recibido de la Empresa la cantidad especificada en este recibo, que comprende la totalidad de mi salario al período que se indica en el mismo.
                </p>
                <div class="row mt-4">
                    <div class="col-6">
                        <p class="text-center">
                            Recibí conforme<br/>
                            _______________________<br/>
                            <span t-field="o.employee_id"/><br/>
                            <span t-field="o.employee_id.identification_id"/>
                        </p>
                    </div>
                    <div class="col-6">
                        <p class="text-center">
                            Firma Autorizada<br/>
                            _______________________<br/>
                            <span t-field="o.company_id.name"/>
                        </p>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo> 