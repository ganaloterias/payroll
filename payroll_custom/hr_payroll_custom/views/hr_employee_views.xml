<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_employee_view_form_dependent_children" model="ir.ui.view">
        <field name="name">hr.employee.view.form.dependent.children</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']/group/group[@name='emergency']" position="after">
                <group string="Información Familiar">
                    <separator string="Hijos Dependientes"/>
                    <field name="dependent_children_ids" widget="one2many_list"
                        string="Hijos" options="{'no_create': True}" readonly="0">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                            <field name="relationship"/>
                            <field name="is_minor" readonly="1" widget="boolean_toggle"/>
                        </list>
                    </field>
                    <button name="action_add_child" type="object"
                        string="Añadir Hijo" class="btn-primary"/>
                    <button name="action_view_dependents" type="object"
                        string="Ver Todos" class="btn-secondary"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_hr_employee_dependent_list" model="ir.ui.view">
        <field name="name">hr.employee.dependent.list</field>
        <field name="model">hr.employee.dependent</field>
        <field name="arch" type="xml">
            <list string="Hijos Dependientes" 
                  decoration-success="is_minor == True"
                  decoration-info="age >= 18">
                <field name="name"/>
                <field name="birth_date"/>
                <field name="age" readonly="1"/>
                <field name="relationship"/>
                <field name="is_minor" readonly="1" widget="boolean_toggle"/>
                <field name="employee_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_dependent_form" model="ir.ui.view">
        <field name="name">hr.employee.dependent.form</field>
        <field name="model">hr.employee.dependent</field>
        <field name="arch" type="xml">
            <form string="Hijo Dependiente">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                        </group>
                        <group>
                            <field name="relationship"/>
                            <field name="is_minor" readonly="1" widget="boolean_toggle"/>
                            <field name="employee_id" readonly="context.get('default_employee_id')"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_dependent_search" model="ir.ui.view">
        <field name="name">hr.employee.dependent.search</field>
        <field name="model">hr.employee.dependent</field>
        <field name="arch" type="xml">
            <search string="Buscar Dependientes">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="relationship"/>
                <separator/>
                <filter string="Menores de Edad" name="minors" domain="[('is_minor', '=', True)]"/>
                <filter string="Mayores de Edad" name="adults" domain="[('is_minor', '=', False)]"/>
                <separator/>
                <filter string="Hijos" name="sons" domain="[('relationship', '=', 'son')]"/>
                <filter string="Hijas" name="daughters" domain="[('relationship', '=', 'daughter')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Empleado" name="employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Relación" name="relationship" context="{'group_by': 'relationship'}"/>
                    <filter string="Edad" name="age" context="{'group_by': 'age'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_dependent" model="ir.actions.act_window">
        <field name="name">Hijos Dependientes</field>
        <field name="res_model">hr.employee.dependent</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_minors': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay hijos dependientes registrados
            </p>
            <p>
                Cree un nuevo hijo dependiente utilizando el botón "Nuevo".
            </p>
        </field>
    </record>
</odoo>
