<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Grupos RRHH -->
  <record id="group_liquidation_manager" model="res.groups">
    <field name="name">Liquidation Manager</field>
    <field name="category_id" ref="base.module_category_human_resources"/>
  </record>
  <record id="group_liquidation_employee" model="res.groups">
    <field name="name">Liquidation Employee</field>
    <field name="category_id" ref="base.module_category_human_resources"/>
  </record>

  <!-- Regla: empleado ve sólo sus propias liquidaciones -->
  <record id="rule_liquidation_employee" model="ir.rule">
    <field name="name">Employee own liquidation</field>
    <field name="model_id" ref="model_hr_liquidation"/>
    <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
    <field name="groups" eval="[(4, ref('group_liquidation_employee'))]"/>
  </record>
</odoo>
