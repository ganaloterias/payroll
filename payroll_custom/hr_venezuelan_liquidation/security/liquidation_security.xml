<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Categoría de Seguridad -->
        <record id="module_category_hr_liquidation" model="ir.module.category">
            <field name="name">Gestión de Liquidaciones</field>
            <field name="description">Gestión de liquidaciones de empleados</field>
            <field name="sequence">20</field>
        </record>

        <!-- Grupo de Usuario -->
        <record id="group_hr_liquidation_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_category_hr_liquidation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo de Administrador -->
        <record id="group_hr_liquidation_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="module_category_hr_liquidation"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_liquidation_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Reglas de Registro -->
        <record id="hr_liquidation_comp_rule" model="ir.rule">
            <field name="name">Liquidaciones: ver solo las de su compañía</field>
            <field name="model_id" ref="model_hr_liquidation"/>
            <field name="domain_force">[('company_id', 'in', [user.company_id.id, False])]</field>
            <field name="groups" eval="[(4, ref('group_hr_liquidation_user'))]"/>
        </record>

        <!-- Reglas multi-compañía -->
        <record id="hr_liquidation_line_comp_rule" model="ir.rule">
            <field name="name">Líneas: multi-compañía</field>
            <field name="model_id" ref="model_hr_liquidation_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('liquidation_id.company_id','in',company_ids)]</field>
        </record>
    </data>
</odoo>
