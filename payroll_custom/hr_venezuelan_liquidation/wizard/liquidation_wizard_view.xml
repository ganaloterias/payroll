<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_hr_liquidation_wizard_form" model="ir.ui.view">
    <field name="name">hr.liquidation.wizard.form</field>
    <field name="model">hr.liquidation.wizard</field>
    <field name="arch" type="xml">
      <form string="Crear Liquidación">
        <sheet>
          <div class="alert alert-info" role="status">
            <strong>Información:</strong> Complete los datos para crear una nueva liquidación.
            El sistema validará automáticamente la información del empleado y contrato.
          </div>
          
          <group>
            <group string="Datos del Empleado">
              <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
              <field name="liquidation_type"/>
              <field name="date_end"/>
            </group>
            <group string="Información del Contrato" invisible="not contract_id">
              <field name="contract_id" readonly="1"/>
              <field name="contract_start_date" readonly="1"/>
              <field name="last_wage" readonly="1"/>
              <field name="currency_id" readonly="1"/>
              <field name="work_years" readonly="1" widget="float_time"/>
            </group>
          </group>
          
          <group string="Observaciones" invisible="not notes">
            <field name="notes" nolabel="1" placeholder="Observaciones adicionales sobre la liquidación..."/>
          </group>
        </sheet>
        <footer>
          <button name="action_create_liquidation" string="Crear Liquidación" 
                  type="object" class="btn-primary" data-hotkey="q"/>
          <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_hr_liquidation_wizard" model="ir.actions.act_window">
    <field name="name">Crear Liquidación</field>
    <field name="res_model">hr.liquidation.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
