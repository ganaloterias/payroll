<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_hr_liquidation_wizard_form" model="ir.ui.view">
    <field name="name">hr.liquidation.wizard.form</field>
    <field name="model">hr.liquidation.wizard</field>
    <field name="arch" type="xml">
      <form string="Crear Liquidación">
        <group>
          <group>
            <field name="employee_id"/>
            <field name="date_end"/>
          </group>
          <group>
            <field name="reason"/>
          </group>
        </group>
        <group string="Observaciones">
          <field name="notes" nolabel="1"/>
        </group>
        <footer>
          <button name="action_create_liquidation" string="Crear Liquidación" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_hr_liquidation_wizard" model="ir.actions.act_window">
    <field name="name">Crear Liquidación</field>
    <field name="res_model">hr.liquidation.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
