<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_hr_liquidation_payment_wizard_form" model="ir.ui.view">
    <field name="name">hr.liquidation.payment.wizard.form</field>
    <field name="model">hr.liquidation.payment.wizard</field>
    <field name="arch" type="xml">
      <form string="Registrar Pago de Liquidación">
        <sheet>
          <div class="alert alert-info" role="status">
            <strong>Información:</strong> Complete los datos del pago para finalizar la liquidación.
            Esta acción cambiará el estado de la liquidación a "Finalizado".
          </div>
          
          <group>
            <group string="Liquidación">
              <field name="liquidation_id" options="{'no_create': True, 'no_open': True}"/>
              <field name="employee_id" readonly="1"/>
              <field name="total_amount" readonly="1"/>
              <field name="currency_id" readonly="1"/>
            </group>
            <group string="Datos del Pago">
              <field name="payment_date"/>
              <field name="payment_reference" placeholder="Número de transferencia, cheque, etc."/>
              <field name="payment_method"/>
            </group>
          </group>
          
          <group string="Notas Adicionales" invisible="not notes">
            <field name="notes" nolabel="1" placeholder="Observaciones adicionales sobre el pago..."/>
          </group>
        </sheet>
        <footer>
          <button name="action_register_payment" string="Registrar Pago" 
                  type="object" class="btn-primary" data-hotkey="q"/>
          <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_hr_liquidation_payment_wizard" model="ir.actions.act_window">
    <field name="name">Registrar Pago</field>
    <field name="res_model">hr.liquidation.payment.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
