<odoo>
  <record id="view_hr_payslip_run_tree_currency" model="ir.ui.view">
    <field name="name">hr.payslip.run.tree.currency</field>
    <field name="model">hr.payslip.run</field>
    <field name="inherit_id" ref="payroll.hr_payslip_run_view_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="currency_id" string="Moneda"/>
      </xpath>
    </field>
  </record>
</odoo>
