<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_loan_list" model="ir.ui.view">
        <field name="name">hr.loan.list</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <list string="Préstamos">
                <field name="name" string="Referencia"/>
                <field name="employee_id" string="Empleado"/>
                <field name="amount" string="Monto del préstamo" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="installment_count" string="Número de cuotas"/>
                <field name="remaining_amount" string="Saldo Pendiente" widget="monetary"/>
                <field name="start_date" string="Fecha de inicio"/>
                <field name="state" string="Estado" widget="badge" 
                       decoration-success="state == 'done'"
                       decoration-info="state == 'running'"
                       decoration-warning="state == 'approved'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_loan_form" model="ir.ui.view">
        <field name="name">hr.loan.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <form string="Préstamo">
                <header>
                    <button name="action_approve" type="object" string="Aprobar" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Iniciar" 
                            class="btn-secondary" invisible="state != 'approved'"/>
                    <button name="action_done" type="object" string="Finalizar" 
                            class="btn-success" invisible="state != 'running'"/>
                    <button name="action_cancel" type="object" string="Cancelar" 
                            class="btn-danger" invisible="state not in ['draft', 'approved']"/>
                    <button name="action_draft" type="object" string="Volver a Borrador" 
                            class="btn-secondary" invisible="state not in ['approved', 'cancelled']"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,approved,running,done"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Referencia del préstamo"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Información del Préstamo">
                            <field name="employee_id" string="Empleado" 
                                   options="{'no_create': True}" 
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" string="Moneda" 
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="amount" string="Monto del préstamo" 
                                   widget="monetary" 
                                   readonly="state != 'draft'"/>
                            <field name="installment_count" string="Número de cuotas" 
                                   readonly="state != 'draft'"/>
                            <field name="installment_amount" string="Monto por cuota" 
                                   readonly="1" widget="monetary"/>
                        </group>
                        <group string="Fechas y Estado">
                            <field name="start_date" string="Fecha de inicio" 
                                   readonly="state != 'draft'"/>
                            <field name="remaining_amount" string="Saldo Pendiente" 
                                   readonly="1" widget="monetary"/>
                            <field name="all_installments_paid" string="Todas las cuotas pagadas" 
                                   readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" 
                                   readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Cuotas" name="installments">
                            <field name="installment_ids" readonly="state == 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" string="Secuencia"/>
                                    <field name="date_due" string="Fecha de vencimiento"/>
                                    <field name="amount" string="Monto" widget="monetary"/>
                                    <field name="paid" string="Pagado"/>
                                    <field name="payslip_id" string="Nómina aplicada" readonly="1"/>
                                    <field name="payment_date" string="Fecha de pago" readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="remaining_amount" string="Saldo Pendiente" 
                                       readonly="1" widget="monetary" 
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        
                        <page string="Observaciones" name="notes">
                            <field name="notes" nolabel="1" placeholder="Observaciones adicionales..."/>
                        </page>
                        
                        <page string="Mensajes" name="messages">
                            <div class="oe_chatter">
                                <field name="message_follower_ids"/>
                                <field name="activity_ids"/>
                                <field name="message_ids"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_loan_search" model="ir.ui.view">
        <field name="name">hr.loan.search</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <search string="Buscar Préstamos">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="amount"/>
                <separator/>
                <filter string="Borrador" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Aprobado" name="approved" domain="[('state','=','approved')]"/>
                <filter string="En Curso" name="running" domain="[('state','=','running')]"/>
                <filter string="Completado" name="done" domain="[('state','=','done')]"/>
                <filter string="Cancelado" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Con Saldo Pendiente" name="with_balance" 
                        domain="[('remaining_amount','>',0)]"/>
                <filter string="Sin Saldo Pendiente" name="without_balance" 
                        domain="[('remaining_amount','=',0)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Empleado" name="employee" 
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Estado" name="state" 
                            context="{'group_by': 'state'}"/>
                    <filter string="Mes de Inicio" name="month" 
                            context="{'group_by': 'start_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hr_loan_kanban" model="ir.ui.view">
        <field name="name">hr.loan.kanban</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="remaining_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details d-flex flex-column">
                                <div class="d-flex align-items-center mb-2">
                                    <strong class="flex-grow-1"><field name="name"/></strong>
                                    <span class="badge bg-warning" invisible="state != 'draft'">Borrador</span>
                                    <span class="badge bg-info" invisible="state != 'approved'">Aprobado</span>
                                    <span class="badge bg-primary" invisible="state != 'running'">En Curso</span>
                                    <span class="badge bg-success" invisible="state != 'done'">Completado</span>
                                    <span class="badge bg-danger" invisible="state != 'cancelled'">Cancelado</span>
                                </div>
                                <div class="d-flex flex-column mb-2">
                                    <span><b>Empleado:</b> <field name="employee_id"/></span>
                                    <span><b>Monto:</b> <field name="amount" widget="monetary"/></span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span><b>Saldo:</b> <field name="remaining_amount" widget="monetary"/></span>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_right">
                                        <button name="action_approve" string="Aprobar" 
                                                type="object" class="btn btn-sm btn-primary" 
                                                invisible="state != 'draft'"/>
                                        <button name="action_start" string="Iniciar" 
                                                type="object" class="btn btn-sm btn-secondary" 
                                                invisible="state != 'approved'"/>
                                        <button name="action_done" string="Finalizar" 
                                                type="object" class="btn btn-sm btn-success" 
                                                invisible="state != 'running'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hr_loan" model="ir.actions.act_window">
        <field name="name">Préstamos</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No existen préstamos registrados
            </p>
            <p>
                Cree un nuevo préstamo utilizando el botón "Nuevo".
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_loan_root" 
              name="Préstamos" 
              parent="payroll.payroll_menu_root" 
              sequence="80"/>
    <menuitem id="menu_hr_loan" 
              name="Gestión de Préstamos" 
              parent="menu_hr_loan_root" 
              action="action_hr_loan" 
              sequence="10"/>
</odoo>
