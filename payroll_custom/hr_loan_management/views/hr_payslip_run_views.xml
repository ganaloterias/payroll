<odoo>
  <record id="view_hr_payslip_run_form_currency" model="ir.ui.view">
    <field name="name">hr.payslip.run.form.currency</field>
    <field name="model">hr.payslip.run</field>
    <field name="inherit_id" ref="payroll.hr_payslip_run_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form//field[@name='date_start']" position="after">
        <field name="currency_id"/>
      </xpath>
    </field>
  </record>
</odoo>
