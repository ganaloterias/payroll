<odoo>
  <record id="view_hr_payslip_form_currency" model="ir.ui.view">
    <field name="name">hr.payslip.form.currency</field>
    <field name="model">hr.payslip</field>
    <field name="inherit_id" ref="payroll.hr_payslip_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form//field[@name='contract_id']" position="after">
        <field name="currency_id"/>
      </xpath>
    </field>
  </record>
</odoo>
